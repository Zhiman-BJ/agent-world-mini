# 复制为 config/api_keys.env；目标文件已被 Git 忽略。

# OpenAI-compatible 模型调用配置。
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=90
LLM_STREAM=false

# DeepSeek Harness Research Agent。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DataGen 下载公开或已授权数据时使用的可选只读凭据。
# GitHub CLI 和 API；建议使用只读的 fine-grained token。
GH_TOKEN=
# Hugging Face；只授予读取公开或已人工获准数据集的权限。
HF_TOKEN=
# Kaggle API token；需要先由账号所有者接受相应数据条款。
KAGGLE_API_TOKEN=

# 可选并发配置。
SEMANTIC_REVIEW_WORKERS=1
