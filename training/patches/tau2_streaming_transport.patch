+def _openai_compatible_streaming_completion(
+    model: str,
+    messages: list[dict[str, Any]],
+    tools: Optional[list[dict[str, Any]]],
+    tool_choice: Optional[str],
+    **kwargs: Any,
+) -> ModelResponse:
+    """Read one OpenAI-compatible SSE response without reusing broken sockets."""
+    api_base = kwargs.get("api_base") or os.environ.get("OPENAI_API_BASE")
+    api_key = kwargs.get("api_key") or os.environ.get("OPENAI_API_KEY")
+    if not api_base or not api_key:
+        raise ValueError("Streaming OpenAI-compatible calls require an API base and key")
+
+    request_timeout = float(kwargs.get("timeout", 180))
+    retries = int(kwargs.get("num_retries", DEFAULT_MAX_RETRIES))
+    payload: dict[str, Any] = {
+        "model": model.removeprefix("openai/"),
+        "messages": messages,
+        "stream": True,
+    }
+    for key in (
+        "temperature",
+        "top_p",
+        "max_tokens",
+        "max_completion_tokens",
+        "response_format",
+        "seed",
+        "stop",
+        "presence_penalty",
+        "frequency_penalty",
+    ):
+        if kwargs.get(key) is not None:
+            payload[key] = kwargs[key]
+    if tools:
+        payload["tools"] = tools
+    if tool_choice:
+        payload["tool_choice"] = tool_choice
+
+    url = f"{api_base.rstrip('/')}/chat/completions"
+    headers = {
+        "Authorization": f"Bearer {api_key}",
+        "Content-Type": "application/json",
+        "Connection": "close",
+    }
+
+    for attempt in range(retries + 1):
+        try:
+            content_parts: list[str] = []
+            reasoning_parts: list[str] = []
+            tool_calls: dict[int, dict[str, Any]] = {}
+            finish_reason = None
+            response_id = None
+            response_model = payload["model"]
+            created = None
+            usage: dict[str, Any] = {}
+            saw_chunk = False
+
+            with requests.post(
+                url,
+                headers=headers,
+                json=payload,
+                stream=True,
+                timeout=(15, request_timeout),
+            ) as raw_response:
+                if raw_response.status_code != 200:
+                    body = raw_response.text[:1000]
+                    raise RuntimeError(
+                        f"Streaming API returned {raw_response.status_code}: {body}"
+                    )
+                for raw_line in raw_response.iter_lines(decode_unicode=True):
+                    line = raw_line.strip() if raw_line else ""
+                    if not line.startswith("data:"):
+                        continue
+                    data = line[5:].strip()
+                    if data == "[DONE]":
+                        break
+                    chunk = json.loads(data)
+                    if chunk.get("error"):
+                        raise RuntimeError(f"Streaming API error: {chunk['error']}")
+                    saw_chunk = True
+                    response_id = chunk.get("id", response_id)
+                    response_model = chunk.get("model", response_model)
+                    created = chunk.get("created", created)
+                    if chunk.get("usage"):
+                        usage = chunk["usage"]
+                    choices = chunk.get("choices") or []
+                    if not choices:
+                        continue
+                    choice = choices[0]
+                    finish_reason = choice.get("finish_reason") or finish_reason
+                    delta = choice.get("delta") or {}
+                    if delta.get("content"):
+                        content_parts.append(delta["content"])
+                    if delta.get("reasoning_content"):
+                        reasoning_parts.append(delta["reasoning_content"])
+                    for tool_call in delta.get("tool_calls") or []:
+                        index = int(tool_call.get("index", 0))
+                        current = tool_calls.setdefault(
+                            index,
+                            {
+                                "id": tool_call.get("id") or f"call_{index}",
+                                "type": "function",
+                                "function": {"name": "", "arguments": ""},
+                            },
+                        )
+                        if tool_call.get("id"):
+                            current["id"] = tool_call["id"]
+                        function = tool_call.get("function") or {}
+                        if function.get("name"):
+                            current["function"]["name"] += function["name"]
+                        if function.get("arguments"):
+                            current["function"]["arguments"] += function["arguments"]
+
+            if not saw_chunk:
+                raise RuntimeError("Streaming API returned no SSE chunks")
+
+            message: dict[str, Any] = {
+                "role": "assistant",
+                "content": "".join(content_parts) or None,
+            }
+            if reasoning_parts:
+                message["reasoning_content"] = "".join(reasoning_parts)
+            if tool_calls:
+                message["tool_calls"] = [tool_calls[index] for index in sorted(tool_calls)]
+            normalized_usage = {
+                "prompt_tokens": usage.get("prompt_tokens", 0),
+                "completion_tokens": usage.get("completion_tokens", 0),
+                "total_tokens": usage.get("total_tokens", 0),
+            }
+            return ModelResponse(
+                id=response_id,
+                created=created,
+                model=response_model,
+                choices=[
+                    {
+                        "index": 0,
+                        "finish_reason": finish_reason or "stop",
+                        "message": message,
+                    }
+                ],
+                usage=normalized_usage,
+            )
+        except (requests.RequestException, RuntimeError, ValueError) as exc:
+            if attempt >= retries:
+                raise
+            logger.warning(
+                f"Streaming request failed ({attempt + 1}/{retries + 1}): {exc}"
+            )
+            time.sleep(min(10, 2**attempt))
+
+    raise RuntimeError("Streaming request exhausted retries")
+
