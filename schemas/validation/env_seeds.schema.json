{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/validation/env_seeds.schema.json",
  "title": "Agent-World Environment Seed Validation v1.1",
  "description": "用于发布前验证环境种子集合；字段结构与环境种子契约 v1.1 一致。",
  "$comment": "除本 Schema 外，Validator 还必须重算 global_id，检查集合级唯一性、URL 来源关系，以及 others.tool_count 与 init_ref_tools 长度相等；来源参考工具的重名只审计，不在种子层静默删除。",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {"$ref": "#/$defs/environmentSeed"},
  "$defs": {
    "snakeCaseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "environmentSeed": {
      "type": "object",
      "properties": {
        "global_id": {
          "$ref": "#/$defs/snakeCaseId",
          "description": "由 source、规范化后的 name 和 index 组成的稳定全局标识。"
        },
        "schema_version": {"type": "string", "const": "1.1"},
        "environment": {"$ref": "#/$defs/seedEnvironment"},
        "init_ref_tools": {
          "type": "array",
          "items": {"$ref": "#/$defs/referenceTool"}
        },
        "init_ref_tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/referenceTask"}
        },
        "others": {"$ref": "#/$defs/otherInformation"}
      },
      "required": ["global_id", "schema_version", "environment", "init_ref_tools", "init_ref_tasks", "others"],
      "additionalProperties": false
    },
    "seedEnvironment": {
      "type": "object",
      "properties": {
        "basic_info": {"$ref": "#/$defs/basicInfo"},
        "description": {"type": "string", "minLength": 1},
        "description_zh": {
          "type": "string",
          "minLength": 1,
          "description": "可选的中文展示译文，不替代来源描述。"
        },
        "domain": {"$ref": "#/$defs/domain"}
      },
      "required": ["basic_info", "description", "domain"],
      "additionalProperties": false
    },
    "basicInfo": {
      "type": "object",
      "properties": {
        "source": {"$ref": "#/$defs/snakeCaseId"},
        "url": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "format": "uri"}
        },
        "name": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "种子所依据的来源快照、发布版或采集日期。"
        },
        "index": {"type": "integer", "minimum": 1}
      },
      "required": ["source", "url", "name", "version", "index"],
      "additionalProperties": false
    },
    "categoryLevel": {
      "oneOf": [
        {"$ref": "#/$defs/snakeCaseId"},
        {"type": "null"}
      ]
    },
    "domain": {
      "type": "object",
      "properties": {
        "level1": {"$ref": "#/$defs/categoryLevel"},
        "level2": {"$ref": "#/$defs/categoryLevel"},
        "level3": {"$ref": "#/$defs/categoryLevel"}
      },
      "required": ["level1", "level2", "level3"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"level1": {"type": "null"}}, "required": ["level1"]},
          "then": {"properties": {"level2": {"type": "null"}, "level3": {"type": "null"}}}
        },
        {
          "if": {"properties": {"level2": {"type": "null"}}, "required": ["level2"]},
          "then": {"properties": {"level3": {"type": "null"}}}
        }
      ]
    },
    "parameterMap": {
      "type": "object",
      "description": "参数名到来源参数定义的直接映射；参数定义按来源保留。",
      "additionalProperties": true
    },
    "referenceFunction": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "input": {"$ref": "#/$defs/parameterMap"},
        "output": {},
        "ori_input": {"type": "string"},
        "ori_description": {"type": "string"}
      },
      "required": ["name", "description", "input", "output"],
      "additionalProperties": false
    },
    "referenceTool": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["function", "class"]},
        "module": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "description_zh": {"type": "string", "minLength": 1},
        "input": {
          "oneOf": [
            {"$ref": "#/$defs/parameterMap"},
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "output": {},
        "function": {
          "type": "array",
          "items": {"$ref": "#/$defs/referenceFunction"}
        },
        "ori_input": {"type": "string"},
        "ori_description": {"type": "string"}
      },
      "required": ["name", "type", "module", "description", "input"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "function"}}, "required": ["type"]},
          "then": {
            "properties": {"input": {"$ref": "#/$defs/parameterMap"}},
            "required": ["output"]
          }
        },
        {
          "if": {"properties": {"type": {"const": "class"}}, "required": ["type"]},
          "then": {"required": ["function"]}
        }
      ]
    },
    "referenceTask": {
      "type": "object",
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "input": {},
        "output": {},
        "solution_path": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "object"}
            ]
          }
        }
      },
      "required": ["description", "input", "output", "solution_path"],
      "additionalProperties": false
    },
    "otherInformation": {
      "type": "object",
      "properties": {
        "tool_count": {"type": "integer", "minimum": 0}
      },
      "required": ["tool_count"],
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
      "additionalProperties": true
    }
  }
}
