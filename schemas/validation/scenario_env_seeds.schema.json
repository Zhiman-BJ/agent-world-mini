{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/validation/scenario_env_seeds.schema.json",
  "title": "Agent-World Scenario Environment Seed Validation v1.1",
  "description": "用于验证由现实业务场景组织、并由一个或多个 Python 包共同支撑的环境种子集合。",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {"$ref": "#/$defs/environmentSeed"},
  "$defs": {
    "environmentSeed": {
      "type": "object",
      "properties": {
        "global_id": {
          "type": "string",
          "pattern": "^semiconductor_scenario_[0-9]{2}_[0-9]{2}_[0-9]{2}$"
        },
        "schema_version": {"type": "string", "const": "scenario-1.1"},
        "environment": {"$ref": "#/$defs/seedEnvironment"},
        "init_ref_tools": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/referenceTool"}
        },
        "init_ref_tasks": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "others": {"$ref": "#/$defs/otherInformation"}
      },
      "required": ["global_id", "schema_version", "environment", "init_ref_tools", "init_ref_tasks", "others"],
      "additionalProperties": false
    },
    "seedEnvironment": {
      "type": "object",
      "properties": {
        "basic_info": {"$ref": "#/$defs/basicInfo"},
        "description": {"type": "string", "minLength": 1},
        "description_zh": {"type": "string", "minLength": 1},
        "domain": {"$ref": "#/$defs/domain"},
        "nums": {"$ref": "#/$defs/toolCounts"}
      },
      "required": ["basic_info", "description", "domain", "nums"],
      "additionalProperties": false
    },
    "basicInfo": {
      "type": "object",
      "properties": {
        "source": {"type": "string", "const": "deep_research"},
        "url": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "format": "uri"}
        },
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 1}
      },
      "required": ["source", "url", "name", "version", "index"],
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "properties": {
        "level1": {"type": "string", "pattern": "^[0-9]{2} .+$"},
        "level2": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2} .+$"},
        "level3": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2} .+$"}
      },
      "required": ["level1", "level2", "level3"],
      "additionalProperties": false
    },
    "toolCounts": {
      "type": "object",
      "properties": {
        "class": {"type": "integer", "minimum": 0},
        "function": {"type": "integer", "minimum": 0},
        "class_func": {"type": "integer", "minimum": 0},
        "all_func": {"type": "integer", "minimum": 0}
      },
      "required": ["class", "function", "class_func", "all_func"],
      "additionalProperties": false
    },
    "parameterMap": {
      "type": "object",
      "additionalProperties": true
    },
    "referenceFunction": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "input": {"$ref": "#/$defs/parameterMap"},
        "output": {},
        "ori_input": {"type": "string"},
        "ori_description": {"type": "string"}
      },
      "required": ["name", "description", "input", "output"],
      "additionalProperties": false
    },
    "referenceTool": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["function", "class"]},
        "module": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "description_zh": {"type": "string", "minLength": 1},
        "input": {
          "oneOf": [
            {"$ref": "#/$defs/parameterMap"},
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "output": {},
        "function": {
          "type": "array",
          "items": {"$ref": "#/$defs/referenceFunction"}
        },
        "ori_input": {"type": "string"},
        "ori_description": {"type": "string"}
      },
      "required": ["name", "type", "module", "description", "input"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "function"}}, "required": ["type"]},
          "then": {
            "properties": {"input": {"$ref": "#/$defs/parameterMap"}},
            "required": ["output"]
          }
        },
        {
          "if": {"properties": {"type": {"const": "class"}}, "required": ["type"]},
          "then": {"required": ["function"]}
        }
      ]
    },
    "otherInformation": {
      "type": "object",
      "properties": {
        "basic_info": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "pypi_package": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "package_relation": {"type": "string", "minLength": 1},
        "package_metadata": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "scenario_design": {"type": "object"},
        "research_sources": {"type": "array", "items": {"type": "object"}},
        "joint_selection": {"type": "object"}
      },
      "required": ["basic_info", "pypi_package", "package_relation", "package_metadata"],
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
      "additionalProperties": true
    }
  }
}
