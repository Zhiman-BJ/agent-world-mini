{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/environment-v2.schema.json",
  "title": "Agent-World Mini Environment v2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "environment_id": {"$ref": "#/$defs/environmentId"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1},
    "record_sets": {
      "type": "array",
      "items": {"$ref": "#/$defs/recordSet"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "filesystem_scopes": {
      "type": "array",
      "items": {"$ref": "#/$defs/filesystemScope"}
    }
  },
  "required": [
    "schema_version", "environment_id", "name", "description",
    "record_sets", "relationships", "filesystem_scopes"
  ],
  "anyOf": [
    {"properties": {"record_sets": {"minItems": 1}}},
    {"properties": {"filesystem_scopes": {"minItems": 1}}}
  ],
  "$defs": {
    "environmentId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
    "assetId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$"},
    "fieldName": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "fieldNames": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/fieldName"}
    },
    "nonEmptyFieldNames": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/fieldName"}
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "filesystem_path"},
        "scope_id": {"$ref": "#/$defs/assetId"},
        "target": {"enum": ["file", "directory"]}
      },
      "required": ["kind", "scope_id", "target"]
    },
    "fieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean", "object", "array"]},
        "description": {"type": "string", "minLength": 1},
        "nullable": {"type": "boolean"},
        "format": {"type": "string", "minLength": 1},
        "pattern": {"type": "string"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "exclusiveMinimum": {"type": "number"},
        "exclusiveMaximum": {"type": "number"},
        "multipleOf": {"type": "number", "exclusiveMinimum": 0},
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true},
        "const": {},
        "properties": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/fieldName"},
          "additionalProperties": {"$ref": "#/$defs/fieldDefinition"}
        },
        "required": {"$ref": "#/$defs/fieldNames"},
        "additionalProperties": {"const": false},
        "items": {"$ref": "#/$defs/fieldDefinition"},
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 0},
        "uniqueItems": {"type": "boolean"},
        "reference": {"$ref": "#/$defs/fileReference"}
      },
      "required": ["type", "description", "nullable"]
    },
    "recordSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_set_id": {"$ref": "#/$defs/assetId"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "access": {"enum": ["read_only", "copy_on_write"]},
        "key_fields": {"$ref": "#/$defs/fieldNames"},
        "fields": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/fieldName"},
          "additionalProperties": {"$ref": "#/$defs/fieldDefinition"}
        }
      },
      "required": ["record_set_id", "name", "description", "access", "key_fields", "fields"]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_set_id": {"$ref": "#/$defs/assetId"},
        "fields": {"$ref": "#/$defs/nonEmptyFieldNames"}
      },
      "required": ["record_set_id", "fields"]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationship_id": {"$ref": "#/$defs/environmentId"},
        "description": {"type": "string", "minLength": 1},
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"},
        "cardinality": {"enum": ["many_to_one", "one_to_one"]}
      },
      "required": ["relationship_id", "description", "from", "to", "cardinality"]
    },
    "layoutNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["file", "file_collection", "directory", "directory_collection"]},
        "path": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "format": {"type": "string", "minLength": 1},
        "content_validation": {"enum": ["strict", "allow_invalid"]},
        "layout": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/layoutNode"}
        }
      },
      "required": ["kind", "path", "description", "required"]
    },
    "structureNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["file", "file_collection", "directory", "directory_collection"]},
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "content_validation": {"enum": ["strict", "allow_invalid"]},
        "layout": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/layoutNode"}
        }
      },
      "required": ["kind", "path"]
    },
    "filesystemScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_id": {"$ref": "#/$defs/assetId"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "access": {"enum": ["read_only", "copy_on_write"]},
        "structure": {"$ref": "#/$defs/structureNode"}
      },
      "required": ["scope_id", "name", "description", "access", "structure"]
    }
  }
}
