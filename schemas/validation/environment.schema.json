{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/validation/environment.schema.json",
  "title": "Agent-World Environment Validation",
  "description": "用于发布前验证不带工具环境对象的完整规则；字段结构与环境契约一致。",
  "$comment": "除本 Schema 外，Validator 还必须检查 resource_id 唯一、引用闭合、文件存在、实体记录布局和只读边界。",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "环境协议版本。"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "description": "环境的稳定唯一标识。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "环境名称。"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "环境对应的现实业务场景、数据范围和用途。"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "环境中实际存在的文件、文件集合和目录。",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "description": "资源内部或资源之间必须遵守的业务规则，可以为空。",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "required": [
    "schema_version",
    "environment_id",
    "name",
    "description",
    "resources",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "description": "环境内唯一的资源标识。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "资源名称。"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "资源包含的数据及其现实业务用途。"
        },
        "data_type": {
          "type": "string",
          "enum": ["raw", "entity", "derived", "output"],
          "description": "资源是原始数据、实体数据、派生数据还是输出位置。"
        },
        "storage_type": {
          "type": "string",
          "enum": ["file", "file_collection", "directory"],
          "description": "资源在工作区中对应单个文件、一组文件或目录。"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$",
          "description": "相对工作区根目录的 POSIX 路径；禁止绝对路径、反斜杠以及 . 或 .. 路径段，file_collection 可以使用 glob。"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._+-]*$",
          "description": "资源格式，例如 json、csv、gdsii、touchstone 或 directory。"
        },
        "writable": {
          "type": "boolean",
          "description": "工具是否允许修改该资源范围内的内容。"
        },
        "source_resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "该实体数据或派生数据所依赖的 resource_id。",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "entity_schema": {
          "type": "object",
          "minProperties": 1,
          "description": "entity 资源包含的实体类型和字段。",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/entity"
          }
        }
      },
      "required": [
        "resource_id",
        "name",
        "description",
        "data_type",
        "storage_type",
        "path",
        "format",
        "writable"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "data_type": {"const": "entity"}
            },
            "required": ["data_type"]
          },
          "then": {
            "required": ["source_resources", "entity_schema"],
            "properties": {
              "format": {
                "enum": ["json", "jsonl", "csv", "parquet", "sqlite"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {"const": "derived"}
            },
            "required": ["data_type"]
          },
          "then": {
            "required": ["source_resources"],
            "not": {
              "required": ["entity_schema"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {"const": "raw"}
            },
            "required": ["data_type"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["source_resources"]},
                {"required": ["entity_schema"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {"const": "output"}
            },
            "required": ["data_type"]
          },
          "then": {
            "properties": {
              "writable": {"const": true}
            },
            "not": {
              "anyOf": [
                {"required": ["source_resources"]},
                {"required": ["entity_schema"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage_type": {"const": "directory"}
            },
            "required": ["storage_type"]
          },
          "then": {
            "properties": {
              "format": {"const": "directory"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {"const": "entity"},
              "format": {"enum": ["jsonl", "csv", "parquet"]}
            },
            "required": ["data_type", "format"]
          },
          "then": {
            "properties": {
              "entity_schema": {"maxProperties": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage_type": {"const": "file_collection"}
            },
            "required": ["storage_type"]
          },
          "then": {
            "properties": {
              "path": {"pattern": ".*[?*\\[]"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage_type": {"enum": ["file", "directory"]}
            },
            "required": ["storage_type"]
          },
          "then": {
            "properties": {
              "path": {"not": {"pattern": ".*[?*\\[]"}}
            }
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "一条该实体记录在现实业务中的含义。"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "description": "实体字段名到字段 Schema 的映射；每个字段必须声明基础类型和无歧义的业务说明。",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/entityField"
          }
        }
      },
      "required": ["description", "fields"],
      "additionalProperties": false
    },
    "entityField": {
      "type": "object",
      "description": "实体字段的标量 JSON Schema。type 和 description 必填；可按字段类型补充枚举、格式、长度、模式或数值范围。",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": ["date", "date-time", "time", "duration", "email", "hostname", "ipv4", "ipv6", "uri", "uuid"]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": ["string", "integer", "number", "boolean"]
          }
        },
        "const": {
          "type": ["string", "integer", "number", "boolean"]
        },
        "pattern": {
          "type": "string"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": ["type", "description"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "string"}}, "required": ["type"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["minimum"]},
                {"required": ["maximum"]},
                {"required": ["exclusiveMinimum"]},
                {"required": ["exclusiveMaximum"]},
                {"required": ["multipleOf"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["integer", "number", "boolean"]}}, "required": ["type"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["format"]},
                {"required": ["pattern"]},
                {"required": ["minLength"]},
                {"required": ["maxLength"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "boolean"}}, "required": ["type"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["minimum"]},
                {"required": ["maximum"]},
                {"required": ["exclusiveMinimum"]},
                {"required": ["exclusiveMaximum"]},
                {"required": ["multipleOf"]}
              ]
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "必须遵守的业务规则。"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "该规则涉及的 resource_id。",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        }
      },
      "required": ["description", "resources"],
      "additionalProperties": false
    }
  }
}
