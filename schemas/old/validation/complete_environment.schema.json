{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/validation/complete_environment.schema.json",
  "title": "Agent-World Complete Environment Validation",
  "description": "用于发布前验证完整可执行环境的规则；顶层和资源字段与完整环境契约一致。",
  "$comment": "除本 Schema 外，Validator 还必须检查资源/工具 ID 唯一、路径和引用闭合、代码执行、读写边界及失败回滚。",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "environment.schema.json#/properties/schema_version"
    },
    "environment_id": {
      "$ref": "environment.schema.json#/properties/environment_id"
    },
    "name": {
      "$ref": "environment.schema.json#/properties/name"
    },
    "description": {
      "$ref": "environment.schema.json#/properties/description"
    },
    "resources": {
      "$ref": "environment.schema.json#/properties/resources"
    },
    "rules": {
      "$ref": "environment.schema.json#/properties/rules"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "环境中的完整工具定义，包括 Agent 可见接口和 Runtime 内部代码。",
      "items": {
        "$ref": "tool.schema.json"
      }
    }
  },
  "required": [
    "schema_version",
    "environment_id",
    "name",
    "description",
    "resources",
    "rules",
    "tools"
  ],
  "additionalProperties": false
}
