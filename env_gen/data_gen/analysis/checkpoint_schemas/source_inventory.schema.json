{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/internal/data-gen/source_inventory.schema.json",
  "title": "Step 2 coarse file inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed_global_id", "seed_sha256", "summary", "sources", "files"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "seed_global_id": {"type": "string", "minLength": 1},
    "seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"$ref": "#/$defs/summary"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nullableCount": {"type": ["integer", "null"], "minimum": 0},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count", "file_count", "total_bytes", "usable_file_count", "structured_record_count", "formats"],
      "properties": {
        "source_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "file_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "total_bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "usable_file_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "structured_record_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "formats": {"$ref": "#/$defs/stringArray"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_name", "status", "reason"],
      "properties": {
        "subject_type": {"enum": ["entity", "tool", "task"]},
        "subject_name": {"type": "string", "minLength": 1},
        "status": {"enum": ["supported", "partial"]},
        "reason": {"type": "string", "minLength": 5}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "file_paths", "file_count", "total_bytes", "structured_record_count", "formats", "content_roles", "source_status", "profile_status", "issues"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "file_paths": {"$ref": "#/$defs/stringArray"},
        "file_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "total_bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "structured_record_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "formats": {"$ref": "#/$defs/stringArray"},
        "content_roles": {"$ref": "#/$defs/stringArray"},
        "source_status": {"type": "string", "minLength": 1},
        "profile_status": {"enum": ["usable", "partial", "unusable", "not_collected"]},
        "issues": {"$ref": "#/$defs/stringArray"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_id", "sha256", "bytes", "format", "record_count", "file_count", "retrieval_stability", "retrieval_urls", "content_roles", "summary", "subjects", "prepared_paths", "issues"],
      "properties": {
        "path": {"type": "string", "pattern": "^raw/.+"},
        "source_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "format": {"type": "string", "minLength": 1},
        "record_count": {"$ref": "#/$defs/nullableCount"},
        "file_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "retrieval_stability": {"enum": ["immutable_repository", "mutable_repository", "timestamped_snapshot", "untracked"]},
        "retrieval_urls": {"$ref": "#/$defs/stringArray"},
        "content_roles": {"$ref": "#/$defs/stringArray"},
        "summary": {"type": "string", "minLength": 1},
        "subjects": {"type": "array", "items": {"$ref": "#/$defs/subject"}},
        "prepared_paths": {"$ref": "#/$defs/stringArray"},
        "issues": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
