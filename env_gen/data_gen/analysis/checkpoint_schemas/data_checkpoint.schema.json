{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/internal/data-gen/data_checkpoint.schema.json",
  "title": "Agent-World Data Collection Checkpoint",
  "description": "数据采集阶段的提交点，不是最终环境协议。",
  "type": "object",
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "seed_global_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["ready", "insufficient_public_data"]},
    "summary": {"type": "string", "minLength": 1},
    "raw_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "entity_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "derived_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "source_file_map": {
      "type": "array",
      "minItems": 1,
      "description": "ready 提交点必填的精确来源到 raw 文件映射；必须覆盖每个 raw 文件且不能重复映射。",
      "items": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "file_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^raw/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
            }
          }
        },
        "required": ["url", "file_paths"],
        "additionalProperties": false
      }
    },
    "synthetic_business_record_count": {"type": "integer", "const": 0}
  },
  "required": [
    "schema_version",
    "seed_global_id",
    "seed_sha256",
    "status",
    "summary",
    "raw_files",
    "entity_files",
    "derived_files",
    "source_urls",
    "synthetic_business_record_count"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ready"}},
        "required": ["status"]
      },
      "then": {
        "required": ["source_file_map"]
      }
    }
  ],
  "additionalProperties": false
}
