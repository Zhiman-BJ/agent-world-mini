{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/program-task-candidate.schema.json",
  "title": "Program-form task candidates",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "archetype_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,127}$"
          },
          "task_internal": {
            "type": "string",
            "minLength": 40
          },
          "workspace_brief": {
            "type": "string",
            "minLength": 20,
            "maxLength": 160
          },
          "task_summary": {
            "type": "string",
            "minLength": 40,
            "maxLength": 320
          },
          "task_public": {
            "type": "string",
            "minLength": 40
          },
          "change_manifest": {
            "type": "object",
            "properties": {
              "baseline_core_deliverables": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 10}
              },
              "preserved_or_replaced": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "original": {"type": "string", "minLength": 10},
                    "new_or_preserved": {"type": "string", "minLength": 10},
                    "acceptance": {"type": "string", "minLength": 10}
                  },
                  "required": ["original", "new_or_preserved", "acceptance"],
                  "additionalProperties": false
                }
              },
              "new_business_outcome": {
                "type": "string",
                "minLength": 20
              },
              "result_driven_decisions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "decision": {"type": "string", "minLength": 10},
                    "evidence_source": {"type": "string", "minLength": 10},
                    "downstream_effect": {"type": "string", "minLength": 10}
                  },
                  "required": ["decision", "evidence_source", "downstream_effect"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "baseline_core_deliverables",
              "preserved_or_replaced",
              "new_business_outcome",
              "result_driven_decisions"
            ],
            "additionalProperties": false
          },
          "output_schema": {
            "type": "object",
            "description": "旧中间候选兼容字段；不会进入正式任务或评测上下文。"
          },
          "task_resources": {
            "type": "object",
            "properties": {
              "record_sets": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "relationships": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "scope_id": {"type": "string", "minLength": 1},
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    },
                    "role": {"enum": ["input", "output"]},
                    "path_is_exact": {"type": "boolean"}
                  },
                  "required": ["scope_id", "path", "role", "path_is_exact"],
                  "additionalProperties": false
                }
              },
              "allowed_tools": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "required": ["record_sets", "relationships", "files", "allowed_tools"],
            "additionalProperties": false
          },
          "solution_code": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "archetype_id",
          "task_internal",
          "workspace_brief",
          "task_summary",
          "task_public",
          "change_manifest",
          "task_resources",
          "solution_code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["candidates"],
  "additionalProperties": false
}
