{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/program-task-candidate.schema.json",
  "title": "Program-form task candidates",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "archetype_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,127}$"
          },
          "task_internal": {
            "type": "string",
            "minLength": 40
          },
          "task_public": {
            "type": "string",
            "minLength": 40
          },
          "output_schema": {
            "type": "object"
          },
          "task_resources": {
            "type": "object",
            "properties": {
              "record_sets": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "relationships": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "scope_id": {"type": "string", "minLength": 1},
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    },
                    "role": {"enum": ["input", "output"]},
                    "path_is_exact": {"type": "boolean"}
                  },
                  "required": ["scope_id", "path", "role", "path_is_exact"],
                  "additionalProperties": false
                }
              },
              "allowed_tools": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "required": ["record_sets", "relationships", "files", "allowed_tools"],
            "additionalProperties": false
          },
          "solution_code": {
            "type": "string",
            "minLength": 20
          }
        },
        "required": [
          "archetype_id",
          "task_internal",
          "task_public",
          "output_schema",
          "task_resources",
          "solution_code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["candidates"],
  "additionalProperties": false
}
