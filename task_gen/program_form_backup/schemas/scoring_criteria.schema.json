{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/program-scoring-criteria.schema.json",
  "type": "object",
  "properties": {
    "rubric_items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[GT][1-9][0-9]*$"},
          "section": {"enum": ["general", "task_specific"]},
          "points": {"type": "integer", "enum": [1, 2, 3]},
          "criterion": {"type": "string", "minLength": 20},
          "evidence_sources": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["candidate_answer", "final_state", "tool_trace"]}
          },
          "judge_method": {"enum": ["deterministic", "rubric_judge"]}
        },
        "required": ["id", "section", "points", "criterion", "evidence_sources", "judge_method"],
        "additionalProperties": false
      }
    },
    "answer_verifier_code": {"type": "string", "minLength": 20},
    "state_verifier_code": {"type": "string", "minLength": 20},
    "state_verification": {
      "type": "object",
      "properties": {
        "mode": {"const": "exact_final_state"},
        "required_effects": {
          "type": "array",
          "items": {"type": "string", "minLength": 12}
        },
        "forbidden_effects": {
          "type": "array",
          "items": {"type": "string", "minLength": 12}
        }
      },
      "required": ["mode", "required_effects", "forbidden_effects"],
      "additionalProperties": false
    },
    "explanation": {"type": "string", "minLength": 20}
  },
  "required": [
    "rubric_items",
    "answer_verifier_code",
    "state_verifier_code",
    "state_verification",
    "explanation"
  ],
  "additionalProperties": false
}
