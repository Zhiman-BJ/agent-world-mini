{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/program-task-research.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "env_id": {"type": "string", "minLength": 1},
    "research_summary": {"type": "string", "minLength": 40},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "pattern": "^https?://"},
          "description": {"type": "string", "minLength": 20}
        },
        "required": ["url", "description"],
        "additionalProperties": false
      }
    },
    "task_archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "archetype_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
          "name": {"type": "string", "minLength": 4},
          "role": {"type": "string", "minLength": 4},
          "trigger": {"type": "string", "minLength": 12},
          "business_goal": {"type": "string", "minLength": 20},
          "workflow": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 8}
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 8}
          },
          "hard_constraints": {
            "type": "array",
            "items": {"type": "string", "minLength": 8}
          },
          "expected_deliverable": {"type": "string", "minLength": 12},
          "common_failure_modes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 8}
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^https?://"}
          },
          "environment_support": {
            "type": "object",
            "properties": {
              "record_sets": {"type": "array", "items": {"type": "string"}},
              "relationships": {"type": "array", "items": {"type": "string"}},
              "filesystem_scopes": {"type": "array", "items": {"type": "string"}},
              "tools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "unsupported_requirements": {"type": "array", "items": {"type": "string"}},
              "generatable": {"type": "boolean"},
              "reason": {"type": "string", "minLength": 12}
            },
            "required": [
              "record_sets",
              "relationships",
              "filesystem_scopes",
              "tools",
              "unsupported_requirements",
              "generatable",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "archetype_id",
          "name",
          "role",
          "trigger",
          "business_goal",
          "workflow",
          "required_evidence",
          "hard_constraints",
          "expected_deliverable",
          "common_failure_modes",
          "source_urls",
          "environment_support"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "env_id", "research_summary", "sources", "task_archetypes"],
  "additionalProperties": false
}
