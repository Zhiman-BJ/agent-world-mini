{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/program-task-package.schema.json",
  "title": "Validated Program-form task package",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_form": {"const": "program"},
    "environment_id": {"type": "string", "minLength": 1},
    "public_environment": {"type": "object"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 40},
          "output_schema": {"type": "object"},
          "reference": {
            "type": "object",
            "properties": {
              "solution_code": {"type": "string"},
              "answer": {"type": "object"},
              "tool_calls": {"type": "array"},
              "initial_state": {"type": "object"},
              "final_state": {"type": "object"},
              "state_diff": {"type": "object"}
            },
            "required": [
              "solution_code",
              "answer",
              "tool_calls",
              "initial_state",
              "final_state",
              "state_diff"
            ],
            "additionalProperties": false
          },
          "validation": {
            "type": "object",
            "properties": {
              "clean_replays": {"type": "integer", "minimum": 2},
              "tool_call_count": {"type": "integer", "minimum": 1},
              "distinct_tool_count": {"type": "integer", "minimum": 1},
              "state_changed": {"type": "boolean"},
              "deterministic": {"const": true}
            },
            "required": [
              "clean_replays",
              "tool_call_count",
              "distinct_tool_count",
              "state_changed",
              "deterministic"
            ],
            "additionalProperties": false
          }
        },
        "required": ["task_id", "task", "output_schema", "reference", "validation"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_form",
    "environment_id",
    "public_environment",
    "tasks"
  ],
  "additionalProperties": false
}
