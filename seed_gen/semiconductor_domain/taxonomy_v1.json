{
  "schema_version": "1.0",
  "title": "面向 Agent 环境生成的半导体领域分类",
  "researched_at": "2026-09-13",
  "classification_note": "本分类综合 IEEE IRDS、NIST CHIPS、SEMI、Accellera、JEDEC 和 IEEE EPS 的公开材料，按工程生命周期与稳定专业工作域重新组织，不是任何单一机构发布的原始分类。",
  "classification_rules": [
    "L1 表示生命周期中的主要工程阶段，不按软件类型或岗位命名。",
    "L2 表示具有稳定目标、核心对象、输入输出和验收方式的专业工作域。",
    "具体任务放在业务场景层，不继续把每个操作拆成固定分类。",
    "仿真、优化、数据库、机器学习和仪器通信等横向技术映射到实际使用它们的 L2。",
    "一个场景可以关联相邻 L2，但必须指定一个主要归属，避免重复统计。"
  ],
  "levels": [
