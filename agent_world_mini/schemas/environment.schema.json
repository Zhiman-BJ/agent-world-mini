{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-world-mini.local/schemas/environment.schema.json",
  "title": "Agent-World Environment Contract",
  "description": "不带工具的 Agent-World 环境协议。",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "环境协议版本。"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "description": "环境的稳定唯一标识。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "环境名称。"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "环境对应的现实业务场景、数据范围和用途。"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "description": "环境中实际存在的文件、文件集合和目录。",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "rules": {
      "type": "array",
      "description": "资源内部或资源之间必须遵守的业务规则，可以为空。",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "required": [
    "schema_version",
    "environment_id",
    "name",
    "description",
    "resources",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "description": "环境内唯一的资源标识。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "资源名称。"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "资源包含的数据及其现实业务用途。"
        },
        "data_type": {
          "type": "string",
          "enum": ["raw", "entity", "derived", "output"],
          "description": "资源是原始数据、实体数据、派生数据还是输出位置。"
        },
        "storage_type": {
          "type": "string",
          "enum": ["file", "file_collection", "directory"],
          "description": "资源在工作区中对应单个文件、一组文件或目录。"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "description": "相对工作区根目录的路径；file_collection 可以使用 glob。"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "description": "资源格式，例如 json、csv、gdsii、touchstone 或 directory。"
        },
        "writable": {
          "type": "boolean",
          "description": "工具是否允许修改该资源范围内的内容。"
        },
        "source_resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "该实体数据或派生数据所依赖的 resource_id。",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "entity_schema": {
          "type": "object",
          "minProperties": 1,
          "description": "entity 资源包含的实体类型和字段。",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/entity"
          }
        }
      },
      "required": [
        "resource_id",
        "name",
        "description",
        "data_type",
        "storage_type",
        "path",
        "format",
        "writable"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "data_type": {"const": "entity"}
            },
            "required": ["data_type"]
          },
          "then": {
            "required": ["source_resources", "entity_schema"],
            "properties": {
              "format": {
                "enum": ["json", "jsonl", "csv", "parquet", "sqlite"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {"const": "derived"}
            },
            "required": ["data_type"]
          },
          "then": {
            "required": ["source_resources"],
            "not": {
              "required": ["entity_schema"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {"const": "raw"}
            },
            "required": ["data_type"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["source_resources"]},
                {"required": ["entity_schema"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {"const": "output"}
            },
            "required": ["data_type"]
          },
          "then": {
            "properties": {
              "writable": {"const": true}
            },
            "not": {
              "anyOf": [
                {"required": ["source_resources"]},
                {"required": ["entity_schema"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage_type": {"const": "directory"}
            },
            "required": ["storage_type"]
          },
          "then": {
            "properties": {
              "format": {"const": "directory"}
            }
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "实体的业务含义。"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "description": "实体字段名到基础数据类型的映射。",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": ["string", "integer", "number", "boolean"]
          }
        }
      },
      "required": ["description", "fields"],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "必须遵守的业务规则。"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "该规则涉及的 resource_id。",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        }
      },
      "required": ["description", "resources"],
      "additionalProperties": false
    }
  }
}
